{
  "integrations": {
    "vercel-kv": {
      "name": "Vercel KV Database",
      "package": "@vercel/kv",
      "env_vars": ["KV_REST_API_URL", "KV_REST_API_TOKEN", "KV_REST_API_READ_ONLY_TOKEN"],
      "allowed_layers": ["infrastructure"],
      "forbidden_layers": ["presentation", "ui"],
      "fallback_required": true,
      "schema_validation_required": true,
      "description": "Redis-compatible key-value database"
    },
    "plausible": {
      "name": "Plausible Analytics",
      "package": "plausible-tracker",
      "env_vars": ["PLAUSIBLE_DOMAIN", "PLAUSIBLE_API_KEY"],
      "allowed_layers": ["infrastructure", "presentation"],
      "forbidden_layers": [],
      "fallback_required": false,
      "schema_validation_required": false,
      "description": "Privacy-focused analytics platform"
    },
    "framer-motion": {
      "name": "Framer Motion",
      "package": "framer-motion",
      "env_vars": [],
      "allowed_layers": ["presentation", "ui"],
      "forbidden_layers": [],
      "fallback_required": false,
      "schema_validation_required": false,
      "description": "Animation library for React"
    },
    "jose": {
      "name": "JOSE JSON Web Tokens",
      "package": "jose",
      "env_vars": [],
      "allowed_layers": ["infrastructure", "application"],
      "forbidden_layers": [],
      "fallback_required": false,
      "schema_validation_required": true,
      "description": "JWT and cryptographic utilities"
    },
    "js-cookie": {
      "name": "JavaScript Cookie",
      "package": "js-cookie",
      "env_vars": [],
      "allowed_layers": ["presentation", "ui", "infrastructure"],
      "forbidden_layers": [],
      "fallback_required": false,
      "schema_validation_required": false,
      "description": "Client-side cookie management"
    },
    "dompurify": {
      "name": "DOMPurify",
      "package": "dompurify",
      "env_vars": [],
      "allowed_layers": ["infrastructure", "application"],
      "forbidden_layers": [],
      "fallback_required": false,
      "schema_validation_required": false,
      "description": "XSS sanitizer for HTML"
    }
  },
  "env_sources": [
    "lib/payments/stripe.ts",
    "lib/analytics/advanced-analytics.ts",
    "lib/email/email-service.ts",
    "lib/cache/edge-cache.ts",
    "lib/production-monitoring.ts"
  ],
  "client_bundle_files": [
    "components/**/*.{ts,tsx}",
    "app/(marketing)/**/*.{ts,tsx}",
    "lib/hooks/**/*.{ts,tsx}",
    "lib/components/**/*.{ts,tsx}"
  ],
  "route_files": [
    "app/api/**/*.ts",
    "app/(marketing)/api/**/*.ts",
    "pages/api/**/*.ts"
  ]
}
