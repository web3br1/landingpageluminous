{
  "taxonomy": {
    "families": {
      "structural_orphaned": {
        "name": "Código Órfão Estrutural",
        "description": "Exports, imports ou rotas não utilizados que quebram a arquitetura",
        "severity_weight": 0.7,
        "common_origins": ["refactor_incomplete", "feature_abandoned", "architecture_change"],
        "typical_impacts": ["maintainability", "developer_cognitive_load", "build_performance"],
        "resolution_patterns": ["remove_unused", "consolidate_similar", "add_tests"]
      },
      "operational_failure": {
        "name": "Falha Operacional",
        "description": "Problemas que afetam operação do sistema em produção",
        "severity_weight": 0.9,
        "common_origins": ["error_handling_missing", "configuration_drift", "integration_failure"],
        "typical_impacts": ["reliability", "performance", "user_experience"],
        "resolution_patterns": ["add_error_boundaries", "implement_fallbacks", "add_monitoring"]
      },
      "security_exposure": {
        "name": "Exposição de Segurança",
        "description": "Vazamentos, acesso não autorizado ou configuração insegura",
        "severity_weight": 1.0,
        "common_origins": ["env_leak", "auth_missing", "secret_exposed"],
        "typical_impacts": ["security", "compliance", "data_protection"],
        "resolution_patterns": ["revoke_credentials", "add_auth_layer", "encrypt_sensitive_data"]
      },
      "architectural_violation": {
        "name": "Violação Arquitetural",
        "description": "Quebra de camadas, acoplamento indevido ou padrões incorretos",
        "severity_weight": 0.6,
        "common_origins": ["layer_mixing", "circular_dependency", "pattern_violation"],
        "typical_impacts": ["maintainability", "scalability", "team_productivity"],
        "resolution_patterns": ["refactor_layers", "extract_abstractions", "add_architecture_tests"]
      },
      "resource_inefficiency": {
        "name": "Ineficiência de Recursos",
        "description": "Uso desnecessário de CPU, memória, bundle size ou dependências",
        "severity_weight": 0.5,
        "common_origins": ["dependency_unused", "bundle_bloat", "memory_leak"],
        "typical_impacts": ["performance", "cost", "scalability"],
        "resolution_patterns": ["remove_dependencies", "optimize_imports", "lazy_loading"]
      },
      "development_hygiene": {
        "name": "Higiene de Desenvolvimento",
        "description": "Problemas de DX que afetam produtividade do time",
        "severity_weight": 0.3,
        "common_origins": ["naming_inconsistent", "structure_messy", "linting_ignored"],
        "typical_impacts": ["developer_productivity", "code_quality", "onboarding"],
        "resolution_patterns": ["standardize_naming", "reorganize_structure", "automate_checks"]
      }
    },
