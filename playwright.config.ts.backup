// playwright.config.ts
import { defineConfig, devices, expect } from '@playwright/test'

// ===== GOVERNANÇA VISUAL - PR-0 =====
// Tolerâncias globais para diffs visuais (reduz falsos positivos)
expect.extend({
  async toHaveScreenshot(subject, name, options = {}): Promise<any> {
    const result = await expect(subject).toHaveScreenshot(name, {
      // Tolerâncias padronizadas para reduzir flake
      threshold: 0.01, // 1% de diferença máxima
      maxDiffPixels: 100, // Máximo 100 pixels diferentes
      maxDiffPixelRatio: 0.001, // Máximo 0.1% dos pixels totais
      // Outras opções padrão
      ...options,
    });
    return result;
  },
});

// ===== CONFIGURAÇÃO BASE PARA TODOS OS LOTES =====
const baseConfig = {
  testDir: './tests',
  testIgnore: [
    '**/api-chatbot.test.ts',
    '**/seo.test.ts',
    '**/integration-landing-page.test.tsx',
    '**/hooks.test.tsx',
    '**/flags.test.ts',
    '**/analytics.test.ts',
    '**/utils.test.ts',
    '**/ui-components.test.tsx',
    '**/composition-validation.test.ts',
    '**/layout-composition.test.ts',
    '**/performance-errors.test.ts',
    '**/webpack-errors.test.ts'
  ],
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  workers: process.env.CI ? 1 : 3,
  reporter: [['list'], ['html', { outputFolder: 'playwright-report', open: 'never' }]],
  timeout: 60_000,
  use: {
    baseURL: process.env.PLAYWRIGHT_BASE_URL || 'http://localhost:3000',
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
    video: 'off',
    actionTimeout: 10000,
    navigationTimeout: 30000,
    reducedMotion: 'reduce',
    permissions: [],
    locale: 'pt-BR',
    timezoneId: 'UTC',
    colorScheme: 'light',
    deviceScaleFactor: 1,
    isMobile: false,
    forcedColors: 'none',
    bypassCSP: false,
  },
  expect: {
    extend: {
      async toHaveScreenshot(subject, name, options = {}) {
        const result = await expect(subject).toHaveScreenshot(name, {
          threshold: 0.01,
          maxDiffPixels: 100,
          maxDiffPixelRatio: 0.001,
          ...options,
        });
        return result;
      },
    },
  },
};

// ===== CONFIGURAÇÃO PRINCIPAL (LOTES) =====
export default defineConfig({
  ...baseConfig,
  projects: [
    // LOTE 1: CORE/CRITICAL - Testes essenciais de funcionamento
    {
      name: 'core-critical',
      testMatch: ['**/hydration.test.ts', '**/ssr.test.ts'],
      use: { ...baseConfig.use },
    },

    // LOTE 2: LANDING PAGE - Funcionalidades da landing page
    {
      name: 'landing-page',
      testMatch: ['**/landing-page-e2e.spec.ts', '**/landing-extra-e2e.spec.ts', '**/e2e-example.spec.ts'],
      use: { ...baseConfig.use },
    },

    // LOTE 3: ACCESSIBILITY - Conformidade WCAG 2.1 AA
    {
      name: 'accessibility',
      testMatch: ['**/accessibility*.spec.ts', '**/a11y/*.spec.ts'],
      use: { ...baseConfig.use },
    },

    // LOTE 4: PERFORMANCE - Core Web Vitals e métricas
    {
      name: 'performance',
      testMatch: ['**/*performance*.spec.ts', '**/performance-example.spec.ts'],
      use: { ...baseConfig.use },
      timeout: 120_000, // Testes de performance precisam de mais tempo
    },

    // LOTE 5: VISUAL REGRESSION - Comparação visual
    {
      name: 'visual-regression',
      testMatch: ['**/visual-regression*.spec.ts'],
      use: {
        ...baseConfig.use,
        screenshot: 'on', // Sempre tirar screenshots para comparação visual
      },
      timeout: 90_000, // Visual regression pode ser mais lento
    },

    // LOTE 6: CRITICAL FLOWS - Fluxos de usuário críticos
    {
      name: 'critical-flows',
      testMatch: ['**/critical-flows-e2e.spec.ts', '**/complete-user-journey*.spec.ts'],
      use: { ...baseConfig.use },
    },

    // LOTE 7: STRESS/LOAD - Testes de carga e stress
    {
      name: 'stress-load',
      testMatch: ['**/load-performance.spec.ts', '**/memory-leaks*.test.tsx', '**/network-failures*.test.ts'],
      use: { ...baseConfig.use },
      workers: 1, // Testes de stress precisam ser sequenciais
      timeout: 180_000, // Muito tempo para testes de carga
    },

    // LOTE 8: INTEGRATION - Testes de integração específicos
    {
      name: 'integration',
      testMatch: ['**/api-integration.test.ts', '**/integration*.test.ts'],
      use: { ...baseConfig.use },
    },
  ],
})
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  workers: process.env.CI ? 1 : 3, // Otimizado para CI e local
  reporter: [['list'], ['html', { outputFolder: 'playwright-report', open: 'never' }]],

  timeout: 60_000,
  use: {
    baseURL: process.env.PLAYWRIGHT_BASE_URL || 'http://localhost:3000',
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
    video: 'off',

    // Otimizações de performance
    actionTimeout: 10000, // Timeout padrão para ações
    navigationTimeout: 30000, // Timeout para navegação

    // ===== GOVERNANÇA VISUAL - CONFIGURAÇÕES DE CONTEXTO =====
    contextOptions: {
      // Reduz uso de memória e estabiliza animações
      reducedMotion: 'reduce',
      // Cache inteligente
      permissions: [],
      // Viewport otimizado e consistente
      viewport: { width: 1280, height: 720 },
      // Estabiliza testes - PR-0
      locale: 'pt-BR',
      timezoneId: 'UTC', // Evita variações por fuso horário
      colorScheme: 'light', // Tema consistente (não dark para screenshots)
      hasTouch: false,
      // Desliga subpixel rendering para screenshots consistentes
      deviceScaleFactor: 1,
      // Força antialiasing consistente
      isMobile: false,
      // Evita variações de fonte (removido - propriedade não existe)
      // Configurações de acessibilidade para testes consistentes
      forcedColors: 'none',
      // Evita variações por geolocalização
      geolocation: undefined,
      // Consistência de cores e temas (já definido acima)
      // Desliga hardware acceleration para screenshots determinísticas
      bypassCSP: false,
    },

    // Otimizações específicas por projeto (sobrescritas nos projetos abaixo)
  },

  expect: {
    toHaveScreenshot: {
      // Evita "pixel flakes" cross-browser com tolerâncias práticas pós-estabilização
      maxDiffPixelRatio: 0.02,       // 2% - permissivo para variações de fonte/AA
      threshold: 0.3,                // tolerância maior para AA
      animations: 'disabled',
      caret: 'hide',
      scale: 'css',
      maxDiffPixels: 500,            // fallback aumentado
    }
  },

  // (globalSetup removido — usaremos mocks via page.route nas specs E2E)

  projects: [
    {
      name: 'chromium',
      use: {
        ...devices['Desktop Chrome'],
        launchOptions: { args: ['--disable-font-subpixel-positioning'] },
        deviceScaleFactor: 1,
        colorScheme: 'light', // tema fixo para snapshots consistentes
      },
    },
    {
      name: 'firefox',
      use: {
        ...devices['Desktop Firefox'],
        deviceScaleFactor: 1,
      },
    },
    {
      name: 'webkit',
      use: {
        ...devices['Desktop Safari'],
        deviceScaleFactor: 1,
      },
    },
    // Projetos otimizados por categoria de teste com configurações específicas
    {
      name: 'fast-tests',
      testMatch: ['**/functional*.spec.ts', '**/basic*.spec.ts'],
      use: {
        ...devices['Desktop Chrome'],
        actionTimeout: 5000,
        navigationTimeout: 10000,
        contextOptions: {
          reducedMotion: 'reduce',
          viewport: { width: 1280, height: 720 },
          permissions: [],
          // Cache otimizado para testes rápidos
          bypassCSP: true,
        },
      },
    },
    {
      name: 'e2e-tests',
      testMatch: ['**/*e2e*.spec.ts', '**/complete-user-journey*.spec.ts'],
      use: {
        ...devices['Desktop Chrome'],
        actionTimeout: 15000,
        navigationTimeout: 20000,
        contextOptions: {
          reducedMotion: 'reduce',
          viewport: { width: 1280, height: 720 },
          permissions: [],
          // Configurações para testes E2E complexos
          recordVideo: process.env.CI ? { dir: 'test-results/videos/' } : undefined,
        },
      },
    },
    {
      name: 'visual-tests',
      testMatch: ['**/visual-regression*.spec.ts'],
      use: {
        ...devices['Desktop Chrome'],
        actionTimeout: 30000,
        navigationTimeout: 30000,
        contextOptions: {
          // ===== GOVERNANÇA VISUAL PARA VISUAL REGRESSION - PR-0 =====
          reducedMotion: 'reduce',
          viewport: { width: 1280, height: 720 }, // Altura consistente
          permissions: [],
          // Configurações específicas para visual regression
          deviceScaleFactor: 1, // Screenshots determinísticos
          hasTouch: false,
          locale: 'pt-BR',
          timezoneId: 'UTC', // Evita variações por fuso
          colorScheme: 'light', // Tema consistente para snapshots
          forcedColors: 'none',
          geolocation: undefined,
          // Font rendering consistente (removido - propriedade não existe)
        },
        screenshot: 'on',
        // Estabiliza fontes anti-aliased cross-browser - PR-0
        launchOptions: {
          args: [
            '--disable-font-subpixel-positioning', // Subpixel off
            '--disable-web-security', // Para testes locais
            '--disable-features=VizDisplayCompositor' // Hardware consistente
          ]
        },
      },
    },
    {
      name: 'performance-tests',
      testMatch: ['**/performance*.spec.ts', '**/load-performance*.spec.ts'],
      use: {
        ...devices['Desktop Chrome'],
        actionTimeout: 60000,
        navigationTimeout: 60000,
        contextOptions: {
          // ===== GOVERNANÇA PARA PERFORMANCE TESTS - PR-0 =====
          reducedMotion: 'reduce',
          viewport: { width: 1280, height: 720 },
          permissions: [],
          // Configurações para testes de performance
          bypassCSP: true,
          ignoreHTTPSErrors: true,
          // Consistência visual durante medição de performance
          deviceScaleFactor: 1,
          locale: 'pt-BR',
          timezoneId: 'UTC',
          colorScheme: 'light',
          forcedColors: 'none',
        },
        // Warm-up consistente para medições de performance
        launchOptions: {
          args: [
            '--disable-font-subpixel-positioning',
            '--disable-background-timer-throttling',
            '--disable-renderer-backgrounding',
            '--disable-backgrounding-occluded-windows'
          ]
        },
      },
    },
    {
      name: 'accessibility-tests',
      testMatch: ['**/a11y*.test.tsx', '**/*accessibility*.spec.ts'],
      use: {
        ...devices['Desktop Chrome'],
        actionTimeout: 20000,
        navigationTimeout: 25000,
        contextOptions: {
          reducedMotion: 'reduce',
          viewport: { width: 1280, height: 720 },
          permissions: [],
          // Configurações para testes de acessibilidade
          forcedColors: 'none',
        },
      },
    },
  ],

  webServer: {
    command: 'npm run dev',
    url: 'http://localhost:3000',
    reuseExistingServer: !process.env.CI,
    timeout: 120 * 1000,
  },
})
