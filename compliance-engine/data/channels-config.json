{
  "engineering-alerts": {
    "type": "github-issues",
    "config": {
      "repo": "local/compliance-alerts",
      "token": "local-dev-token",
      "createIssues": true,
      "autoAssign": true
    }
  },
  "engineering-reports": {
    "type": "github-issues",
    "config": {
      "repo": "local/compliance-reports",
      "token": "local-dev-token",
      "createIssues": false,
      "labels": [
        "report",
        "quarterly"
      ]
    }
  },
  "owner": {
    "type": "github-issues",
    "config": {
      "repo": "local/ownership-alerts",
      "token": "local-dev-token",
      "assignee": "script-owner",
      "labels": [
        "ownership",
        "script-management"
      ]
    }
  },
  "tech-lead": {
    "type": "github-issues",
    "config": {
      "repo": "local/tech-lead-alerts",
      "token": "local-dev-token",
      "assignee": "tech-lead",
      "labels": [
        "tech-lead",
        "escalation"
      ]
    }
  },
  "director": {
    "type": "github-issues",
    "config": {
      "repo": "local/director-alerts",
      "token": "local-dev-token",
      "assignee": "engineering-director",
      "labels": [
        "director",
        "critical",
        "executive"
      ]
    }
  },
  "executive": {
    "type": "github-issues",
    "config": {
      "repo": "local/executive-alerts",
      "token": "local-dev-token",
      "assignee": "ceo",
      "labels": [
        "executive",
        "board",
        "emergency"
      ]
    }
  }
}