{
  "name": "landing-page-luminaris",
  "version": "1.0.0",
  "description": "Landing page SaaS profissional com Next.js, TypeScript e Tailwind CSS",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --config eslint.config.js --ext .ts,.tsx",
    "lint:fix": "eslint . --config eslint.config.js --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit --pretty",
    "quality": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:utils": "vitest run tests/utils/",
    "test:components": "vitest run tests/components/",
    "test:e2e": "npx playwright test",
    "prepare": "husky install",
    "postinstall": "husky install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/recharts": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.24",
    "jose": "^6.1.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.460.0",
    "next": "15.1.6",
    "next-seo": "^7.0.1",
    "plausible-tracker": "^0.3.9",
    "postcss": "^8.5.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "server-only": "^0.0.1",
    "stripe": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cucumber/cucumber": "^12.2.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-istanbul": "^4.0.1",
    "axe-core": "^4.11.0",
    "canvas": "^3.2.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.2.0",
    "eslint": "^9.38.0",
    "form-data": "^4.0.4",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.6",
    "typescript": "5.9.3",
    "uuid": "^13.0.0",
    "vitest": "^4.0.5",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "npm run typecheck"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}