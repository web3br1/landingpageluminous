    "framework": {
      "maxSize": 200000,
      "description": "React + Next.js framework (200KB)",
      "chunks": 5,
      "priority": "critical"
    },
    "total": {
      "maxSize": 1500000,
      "description": "Total bundle size (1.5MB)",
