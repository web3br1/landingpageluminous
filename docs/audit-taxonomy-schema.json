{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit Taxonomy Schema - Semantic Governance",
  "description": "Advanced taxonomy for intelligent error categorization and interrelation",
  "type": "object",
  "properties": {
    "taxonomy": {
      "type": "object",
      "properties": {
        "families": {
          "type": "object",
          "patternProperties": {
            "^[a-z_]+$": {
              "$ref": "#/definitions/ErrorFamily"
            }
          }
        },
        "origins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "areas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "impacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["families", "origins", "areas", "impacts"]
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Relationship"
      }
    }
  },
  "required": ["taxonomy", "relationships"],
  "definitions": {
    "ErrorFamily": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "severity_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "common_origins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "typical_impacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolution_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "description", "severity_weight"]
    },
    "Relationship": {
      "type": "object",
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["depends_on", "causes", "relates_to", "blocks", "enables"]
        },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string" }
      },
      "required": ["source_id", "target_id", "type", "strength"]
    }
  }
}
