{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "types": [
      "@types/node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    // "experimentalDecorators": true,  // Desabilitado - não necessário para React/Next
    // "emitDecoratorMetadata": true,   // Desabilitado - não necessário para React/Next
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/ui/*": [
        "./components/ui/*"
      ],
      "@/onboarding/*": [
        "./components/onboarding/*"
      ],
      "@/recommendations/*": [
        "./components/recommendations/*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/styles/*": [
        "./styles/*"
      ],
      "@/public/*": [
        "./public/*"
      ],
      "@/domains/*": [
        "./domains/*"
      ]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**",
    "coverage/**",
    "tmp/**",
    "lib/testing/**",
    "vitest.config.ts",
    "vitest.setup.ts",
    "jest.config.cjs",
    "jest.setup.js",
    "cucumber.cjs",
    "scripts/templates/**",
    "features/**",
    "test-results/**",
    "qa-baseline/**",
    "reports/**",
    "playwright-report/**"
  ]
}
